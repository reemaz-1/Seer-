rules_version = '2';

// Complete review candidate for the current customer/provider/admin apps.
// Unknown collections and all client-side admin provisioning are denied.
service cloud.firestore {
  match /databases/{database}/documents {
    // Takes no inputs; returns whether Firebase Authentication identified a user.
    function signedIn() { return request.auth != null; }
    // Takes a document uid; returns whether it belongs to the caller.
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    // Takes no inputs; checks the trusted, console-provisioned admin document.
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }
    // Takes no inputs; checks whether the caller has a customer profile.
    function isCustomer() {
      return signedIn()
        && exists(/databases/$(database)/documents/customers/$(request.auth.uid));
    }
    // Takes no inputs; checks verified email and administrator approval.
    function isProvider() {
      return signedIn() && request.auth.token.email_verified == true
        && get(/databases/$(database)/documents/providers/$(request.auth.uid)).data.status == 'approved';
    }
    // Takes allowed field names; returns whether only those fields changed.
    function changesOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    match /admins/{uid} {
      // Supports the admin login role check, including a missing own document.
      allow get: if owns(uid);
      allow list, create, update, delete: if false;
    }
    match /lookup_data/{id} {
      // Vehicle choices are loaded before registration; only this catalogue is public.
      allow read: if id in ['vehicles', 'service_prices'];
      allow write: if false;
    }
    match /customers/{uid} {
      allow get: if owns(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'phone', 'email', 'createdAt'])
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.phone is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow update: if owns(uid)
        && changesOnly(['firstName', 'lastName', 'phone', 'email'])
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.phone is string
        && request.resource.data.email is string;
      match /vehicles/{vehicleId} {
        // Takes no inputs; validates exactly the fields written by Vehicle.toMap.
        function validVehicle() {
          let v = request.resource.data;
          return v.keys().hasOnly(['brand', 'model', 'year', 'color', 'plateNumberArabic', 'plateNumberLatin'])
            && v.brand is string && v.model is string && v.year is int
            && v.color is string && v.plateNumberArabic is string && v.plateNumberLatin is string;
        }
        allow read, delete: if owns(uid);
        allow create, update: if owns(uid) && validVehicle();
      }
    }
    match /providers/{uid} {
      // Takes no inputs; returns profile fields editable by their owner.
      function profileFields() {
        return ['firstName', 'lastName', 'email', 'phone', 'nationalId',
          'vehicleType', 'vehicleBrand', 'vehicleModel', 'vehicleYear', 'vehicleColor',
          'plateNumberArabic', 'plateNumberLatin', 'licenseNumber', 'servicesOffered'];
      }
      // Takes no inputs; verifies the email-confirmed submission for admin review.
      function submitForReview() {
        return request.auth.token.email_verified == true
          && resource.data.status == 'unverified'
          && request.resource.data.status == 'pending'
          && request.resource.data.submittedAt == request.time
          && changesOnly(['status', 'submittedAt']);
      }
      // Takes no inputs; permits owner GPS and availability updates after approval.
      function updateMatching() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return isProvider() && changesOnly(['currentLocation', 'isAvailable'])
          && (!changed.hasAny(['currentLocation']) || request.resource.data.currentLocation is latlng)
          && (!changed.hasAny(['isAvailable']) || (request.resource.data.isAvailable is bool
            && (!request.resource.data.isAvailable || request.resource.data.currentLocation is latlng)));
      }
      // Matching reads approved providers; whole-profile visibility is documented.
      allow get: if owns(uid) || isAdmin()
        || (isCustomer() && resource.data.status == 'approved');
      allow list: if isAdmin() || (isCustomer() && resource.data.status == 'approved');
      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly(profileFields().concat(['status', 'createdAt']))
        && request.resource.data.status == 'unverified'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow update: if (owns(uid) && (changesOnly(profileFields()) || submitForReview() || updateMatching()))
        || (isAdmin() && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'rejected'] && changesOnly(['status']));
    }
    match /orders/{orderId} {
      // Takes no inputs; checks membership in the customer's candidate list.
      function isCandidate() {
        return request.auth.uid in resource.data.get('candidateProviderIds', []);
      }
      // Takes no inputs; checks a fresh pending request against server time.
      function mayRespond() {
        return isProvider() && isCandidate()
          && resource.data.status == 'pending'
          && resource.data.get('providerId', null) in [null, '']
          && resource.data.expiresAt is timestamp && resource.data.expiresAt > request.time
          && !(request.auth.uid in resource.data.get('rejectedBy', []));
      }
      // Takes no inputs; permits only self-assignment with a server timestamp.
      function accepting() {
        return changesOnly(['status', 'providerId', 'acceptedAt'])
          && request.resource.data.status == 'accepted'
          && request.resource.data.providerId == request.auth.uid
          && request.resource.data.acceptedAt == request.time;
      }
      // Takes no inputs; permits only own rejection and exact final-rejection state.
      function rejecting() {
        let previous = resource.data.get('rejectedBy', []).toSet();
        let updated = request.resource.data.rejectedBy.toSet();
        let allRejected = updated.hasAll(resource.data.candidateProviderIds.toSet());
        return changesOnly(['status', 'rejectedBy'])
          && request.resource.data.rejectedBy is list
          && updated == previous.union([request.auth.uid].toSet())
          && request.resource.data.rejectedBy.size() == updated.size()
          && request.resource.data.status == (allRejected ? 'rejected' : 'pending');
      }
      // Takes no inputs; checks the customer creation payload and initial state.
      function validCreation() {
        let o = request.resource.data;
        return isCustomer() && o.customerId == request.auth.uid
          && o.keys().hasOnly(['customerId', 'customerName', 'customerPhone', 'vehicleId',
            'vehicleTitle', 'vehiclePlateArabic', 'vehiclePlateLatin', 'serviceCategoryId',
            'serviceCategoryLabel', 'serviceOptionId', 'serviceOptionLabel', 'serviceBranch',
            'note', 'estimatedPrice', 'finalPrice', 'status', 'pickupLocation', 'dropoffLocation',
            'providerId', 'candidateProviderIds', 'rejectedBy', 'paymentConfirmed', 'createdAt', 'expiresAt'])
          && o.status == 'pending' && o.providerId == null
          && o.finalPrice == null && o.paymentConfirmed == false
          && o.rejectedBy == [] && o.candidateProviderIds is list && o.candidateProviderIds.size() > 0
          && o.candidateProviderIds.size() == o.candidateProviderIds.toSet().size()
          && o.createdAt == request.time && o.expiresAt is timestamp
          // The existing customer app calculates expiresAt on the phone. Allow
          // 15 seconds of positive clock skew, without allowing long deadlines.
          && o.expiresAt > request.time && o.expiresAt <= request.time + duration.value(135, 's')
          && o.pickupLocation is latlng
          && (o.dropoffLocation == null || o.dropoffLocation is latlng)
          && (o.serviceCategoryId != 'towing' || o.dropoffLocation is latlng)
          && o.customerName is string && o.customerPhone is string && o.note is string
          && o.vehicleTitle is string && o.vehiclePlateArabic is string && o.vehiclePlateLatin is string
          && o.serviceCategoryLabel is string && o.serviceOptionId is string
          && o.serviceOptionLabel is string && o.serviceBranch is string
          && o.serviceCategoryId in ['battery', 'fuel', 'tires', 'towing']
          && (o.estimatedPrice == null || (o.estimatedPrice is number && o.estimatedPrice >= 0))
          && exists(/databases/$(database)/documents/customers/$(request.auth.uid)/vehicles/$(o.vehicleId));
      }
      // Takes no inputs; enforces customer cancellation and expiry with server time.
      function cancelling() {
        return owns(resource.data.customerId) && changesOnly(['status', 'cancelledAt'])
          && request.resource.data.cancelledAt == request.time
          && ((request.resource.data.status == 'cancelled'
              && (resource.data.status == 'pending'
                || (resource.data.status == 'accepted' && resource.data.acceptedAt is timestamp
                  && request.time < resource.data.acceptedAt + duration.value(120, 's'))))
            || (request.resource.data.status == 'autoCancelled'
              && resource.data.status == 'pending' && resource.data.expiresAt <= request.time));
      }
      // Takes old/new states and a timestamp field; validates one provider step.
      function step(from, to, timeField) {
        return resource.data.status == from && request.resource.data.status == to
          && changesOnly(['status', timeField]) && request.resource.data[timeField] == request.time;
      }
      // Takes no inputs; supports the existing assigned-provider completion flow.
      function completing() {
        let o = request.resource.data;
        return resource.data.status == 'inProgress' && o.status == 'completed'
          && changesOnly(['status', 'paymentConfirmed', 'finalPrice', 'completedAt', 'completedDay'])
          && o.paymentConfirmed == true && o.completedAt == request.time
          && (o.finalPrice == null || (o.finalPrice is number && o.finalPrice >= 0))
          && o.completedDay is string && o.completedDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }
      // Takes no inputs; restricts lifecycle writes to the assigned approved provider.
      function progressing() {
        return isProvider() && resource.data.providerId == request.auth.uid
          && (step('accepted', 'onTheWay', 'onTheWayAt') || step('onTheWay', 'arrived', 'arrivedAt')
            || step('arrived', 'inProgress', 'inProgressAt') || completing());
      }
      allow read: if owns(resource.data.customerId)
        || (isProvider() && (isCandidate() || resource.data.get('providerId', null) == request.auth.uid));
      allow create: if validCreation();
      allow update: if (mayRespond() && (accepting() || rejecting())) || cancelling() || progressing();
      allow delete: if false;
    }
  }
}
